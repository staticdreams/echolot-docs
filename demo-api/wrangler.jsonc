{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echolot-demo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // demo.echolot.dev (the zone is in the account); no workers.dev address, so the limits can't be walked around.
  "routes": [{ "pattern": "demo.echolot.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Static files the Worker reads itself (the export); every request runs the Worker first, so all of it is rate limited.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "ratelimits": [
    // Every request, per client address: 120 a minute.
    { "name": "RATE_LIMIT", "namespace_id": "4101", "simple": { "limit": 120, "period": 60 } },
    // Large, slow and streaming responses: 10 a minute.
    { "name": "HEAVY", "namespace_id": "4102", "simple": { "limit": 10, "period": 60 } }
  ],
  // TOKEN_KEY (the JWT signing key) is a secret: wrangler secret put TOKEN_KEY
  "observability": { "enabled": true }
}
